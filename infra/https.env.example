# HTTPS opcional para uma instalação Linux/Docker já existente.
# Copie para work/https-linux.env e ajuste os valores no servidor de destino.
# Este arquivo não contém senhas nem chaves. Apenas salvá-lo não ativa o HTTPS.

# Nome DNS que a TI cadastrou para o servidor; sem protocolo, porta ou caminho.
CNUTRI_HOSTNAME=cnutri.preventsenior.com.br

# Pasta Linux privada com servidor.pem (certificado e intermediários) e chave.pem.
# O Nginx monta essa pasta somente para leitura.
CNUTRI_TLS_DIR=/etc/ceres-care/tls

# Endereço incorporado aos NOVOS QR Codes após recriar a API.
# O Compose expande o nome definido acima.
URL_RECEBIMENTO_PUBLICA=https://${CNUTRI_HOSTNAME}
